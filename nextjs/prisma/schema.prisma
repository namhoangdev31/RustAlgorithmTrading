  @@index([bundleId, createdAt], map: "bundle_artifact_manifests_bundle_time")
  @@map("bundle_artifact_manifests")
}

model BundleRolloutExposures {
  id        String   @id @db.Uuid
  rolloutId String   @map("rollout_id") @db.Uuid
  bundleId  String   @map("bundle_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
