  @@index([bundleId], map: "bundle_security_scan_results_bundle_id")
  @@index([result], map: "bundle_security_scan_results_result")
  @@index([scannedAt], map: "bundle_security_scan_results_scanned_at")
  @@map("bundle_security_scan_results")
}

model BundleArtifactManifests {
  id              String   @id @db.Uuid
  bundleId        String   @map("bundle_id") @db.Uuid
  versionId       String?  @unique @map("version_id") @db.Uuid
  storageProvider String   @map("storage_provider") @db.VarChar(30)
  storageBucket   String   @map("storage_bucket") @db.VarChar(100)
  storageKey      String   @map("storage_key") @db.VarChar(500)
  checksumSha256  String   @map("checksum_sha256") @db.VarChar(64)
