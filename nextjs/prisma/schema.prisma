  bundle  Bundles               @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  entries BundleLedgerEntries[]

  @@unique([bundleId, code, currency])
  @@map("bundle_ledger_accounts")
}

model BundleLedgerTransactions {
  id              String   @id @db.Uuid
  bundleId        String   @map("bundle_id") @db.Uuid
  orderId         String?  @map("order_id") @db.Uuid
  transactionType String   @map("transaction_type") @db.VarChar(40)
  status          String   @default("posted") @db.VarChar(20)
  providerRef     String?  @map("provider_ref") @db.VarChar(255)
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(255)
  currency        String   @db.VarChar(3)
  metadata        Json?
  createdAt       DateTime @map("created_at") @db.Timestamp(6)

  bundle  Bundles               @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  entries BundleLedgerEntries[]

  @@index([bundleId, createdAt], map: "bundle_ledger_transactions_time")
  @@index([orderId], map: "bundle_ledger_transactions_order")
  @@map("bundle_ledger_transactions")
}

model BundleLedgerEntries {
  id            String               @id @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  direction     LedgerEntryDirection
  amount        Decimal              @db.Decimal(20, 0)
  currency      String               @db.VarChar(3)
  createdAt     DateTime             @map("created_at") @db.Timestamp(6)

  transaction BundleLedgerTransactions @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
