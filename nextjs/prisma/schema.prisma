  entitlement BundleUserEntitlements @relation(fields: [entitlementId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([entitlementId, tokenPrefix])
  @@index([entitlementId, isRevoked], map: "bundle_entitlement_licenses_active")
  @@map("bundle_entitlement_licenses")
}

model BundleLedgerAccounts {
  id          String   @id @db.Uuid
  bundleId    String   @map("bundle_id") @db.Uuid
  code        String   @db.VarChar(60)
  accountType String   @map("account_type") @db.VarChar(30)
  currency    String   @db.VarChar(3)
