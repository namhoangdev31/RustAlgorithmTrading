generator client {
  provider            = "prisma-client"
  output              = "./generated"
  importFileExtension = "ts"
}

generator pothos {
  provider          = "prisma-pothos-types"
  clientOutput      = "../prisma/generated/"
  output            = "../lib/pothos-prisma-types.ts"
  generateDatamodel = "true"
}

generator ent {
  provider = "tsx ./tools/prisma-ent-generator/index.ts"
  output   = "../../go/internal/data/ent/schema"
}

datasource db {
  provider = "postgresql"
}

enum BundleCatalogStatus {
  draft
  submitted
  published
  suspended
  removed
}

enum BundleReleaseStatus {
  queued
  building
  scanning
  pending_review
  approved
  active
  rejected
  failed
  rolled_back
}

enum BundleArtifactKind {
  full
  delta
  source_map
  sbom
  build_log
}

enum BundleBuildStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum BundleApprovalKind {
  moderation
  privacy
  security
}

enum BundleDeliveryMode {
  none
  rollout
  experiment
}

enum LedgerEntryDirection {
  debit
  credit
}

model Order {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique @map("order_id") @db.VarChar(255)
  symbol      String   @db.VarChar(50)
  side        String   @db.VarChar(10)
  orderType   String   @map("order_type") @db.VarChar(50)
  quantity    Float
  price       Float?
  status      String   @db.VarChar(50)
  submittedAt DateTime @map("submitted_at") @db.Timestamptz

  @@map("orders")
}

model RiskEvent {
  id         Int      @id @default(autoincrement())
  eventType  String   @map("event_type") @db.VarChar(50)
  severity   String   @db.VarChar(20)
  message    String
  metadata   Json?
  occurredAt DateTime @map("occurred_at") @db.Timestamptz

  @@map("risk_events")
}

model File {
  id          String  @id @db.Uuid
  path        String  @db.VarChar(500)
  bucket      String? @db.VarChar(255)
  size        BigInt?
  contentType String? @map("contentType") @db.VarChar(255)
  filename    String? @db.VarChar(255)
  mimetype    String? @db.VarChar(255)

  usersWithPhoto User[] @relation("UserPhoto")

  @@map("files")
}

model User {
  id           String    @id @db.Uuid
  email        String?   @unique @db.VarChar(255)
  password     String?   @db.VarChar(255)
  provider     String    @default("email") @db.VarChar(255)
  socialId     String?   @map("socialId") @db.VarChar(255)
  firstName    String?   @map("firstName") @db.VarChar(255)
  lastName     String?   @map("lastName") @db.VarChar(255)
  fullName     String?   @map("fullName") @db.VarChar(255)
  phone        String?   @unique @db.VarChar(255)
  dateOfBirth  DateTime? @map("dateOfBirth") @db.Timestamp(6)
  gender       String?   @db.VarChar(50)
  userType     String    @default("individual") @map("userType") @db.VarChar(50)
  photoId      String?   @map("photoId") @db.Uuid
  registerType String?   @map("registerType") @db.VarChar(50)
  createdAt    DateTime  @map("createdAt") @db.Timestamp(6)
  updatedAt    DateTime  @map("updatedAt") @db.Timestamp(6)
  deletedAt    DateTime? @map("deletedAt") @db.Timestamp(6)

  // Relations
  photo File? @relation("UserPhoto", fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  payouts                 BundlePayouts[]
  organizations           Organization[]
  notificationsActor      Notifications[]                  @relation("NotificationActor")
  notificationsRecipient  Notifications[]                  @relation("NotificationRecipient")
  sessions                Session[]
  deviceTokens            UserDeviceToken[]
  analytics               BundleAnalyticsEvents[]
  auditLogs               BundleAuditLog[]
  betaTesters             BundleBetaTesters[]
  changedLogs             BundleChangeLogs[]
  collaboratorsInvited    BundleCollaborators[]            @relation("CollaboratorInvitedBy")
  collaborators           BundleCollaborators[]            @relation("CollaboratorUser")
  developerStrikes        BundleDeveloperStrikes[]         @relation("StrikeDeveloper")
  developerStrikesIssued  BundleDeveloperStrikes[]         @relation("StrikeIssuedBy")
  installEvents           BundleInstallEvents[]
  orders                  BundleOrders[]
  reviews                 BundleReviews[]
  stateTransitions        BundleStateTransitions[]
  userReportsReported     BundleUserReports[]              @relation("ReportReportedBy")
  userReportsReviewed     BundleUserReports[]              @relation("ReportReviewedBy")
  refundRequestsReviewed  BundleRefundRequests[]           @relation("RefundReviewedBy")
  refundRequests          BundleRefundRequests[]           @relation("RefundUser")
  userEntitlements        BundleUserEntitlements[]
  reviewReportsReported   BundleReviewReports[]            @relation("ReviewReportReportedBy")
  reviewReportsReviewed   BundleReviewReports[]            @relation("ReviewReportReviewedBy")
  subscriptionHistory     BundleSubscriptionHistory[]
  reviewHistory           BundleReviewHistory[]
  reviewQueueReviewed     BundleReviewQueue[]              @relation("ReviewQueueReviewer")
  userSecrets             UserSecrets[]
  personalAccessTokens    PersonalAccessToken[]
  previewComments         PreviewComment[]
  organizationMemberships OrganizationMembership[]
  projectMemberships      ProjectMembership[]
  leposhipBuilds          LepoShipBuild[]
  developerStrikesRevoked BundleDeveloperStrikes[]         @relation("StrikeRevokedBy")
  releaseApprovals        BundleReleaseApprovals[]         @relation("ReleaseApprovalActor")
  releaseOverridesCreated BundleReleaseOverridesV2[]       @relation("ReleaseOverrideCreator")
  overrideApprovals       BundleReleaseOverrideApprovals[] @relation("ReleaseOverrideApprover")
  canonicalBuildJobs      BundleBuildJobs[]                @relation("BundleBuildTriggeredBy")

  @@map("users")
}

enum OrganizationType {
  personal
  corporate
}

model Organization {
  id        String           @id @db.Uuid
  name      String           @db.VarChar(255)
  type      OrganizationType
  userId    String           @map("user_id") @db.Uuid
  createdAt DateTime         @map("created_at") @db.Timestamp(6)
  updatedAt DateTime         @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamp(6)

  user                User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects            Project[]
  ssoConfig           SsoConfig?
  nativeScimMappings  NativeScimMapping[]
  members             OrganizationMembership[]
  providerConnections WorkspaceProviderConnection[]

  @@unique([userId, type])
  @@map("organizations")
}

model Project {
  id                       String    @id @db.Uuid
  name                     String    @db.VarChar(255)
  description              String?
  organizationId           String    @map("organization_id") @db.Uuid
  vercelProjectId          String?   @map("vercel_project_id") @db.VarChar(255)
  vercelProjectName        String?   @map("vercel_project_name") @db.VarChar(255)
  activeNativeDeploymentId String?   @map("active_native_deployment_id")
  createdAt                DateTime  @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime  @map("updated_at") @db.Timestamp(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamp(6)

  organization               Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeNativeDeployment     NativeDeployment?          @relation("ProjectActiveNativeDeployment", fields: [activeNativeDeploymentId], references: [id], onDelete: SetNull)
  bundle                     Bundles?
  deployHooks                DeployHook[]
  firewallRules              FirewallRule[]
  cronJobs                   CronJob[]
  forms                      Form[]
  previewComments            PreviewComment[]
  lepoShipLocalConfig        LepoShipLocalConfig?
  nativeDeployments          NativeDeployment[]         @relation("ProjectNativeDeployments")
  nativeDomainConfigs        NativeDomainConfig[]
  nativeEdgeFunctions        NativeEdgeFunction[]
  nativeCacheEntries         NativeCacheEntry[]
  nativeReplaySessions       NativeAnalyticsReplay[]
  nativeCrashReports         NativeCrashReport[]
  nativeSourceMaps           NativeSourceMap[]
  nativePluginInstalls       NativePluginInstallation[]
  nativeDebugSessions        NativeDebugSession[]
  nativeConnectedDevices     NativeConnectedDevice[]
  nativeCloudTargets         NativeCloudTarget[]
  nativeRoutingPolicy        NativeRoutingPolicy?
  nativeRegionReplicas       NativeRegionReplica[]
  nativeArtifactMirrors      NativeArtifactMirror[]
  nativeWafEvents            NativeWafEvent[]
  nativeWafRules             NativeWafRule[]
  nativeAiDiagnostics        NativeAiDiagnostic[]
  nativeRemediationRuns      NativeRemediationRun[]
  nativeSchedulingPolicy     NativeSchedulingPolicy?
  nativeSchedulingSignals    NativeSchedulingSignal[]
  nativeServiceIdentities    NativeServiceIdentity[]
  nativeServiceTrustPolicies NativeServiceTrustPolicy[]
  nativeTelemetryEnvelopes   NativeTelemetryEnvelope[]
  members                    ProjectMembership[]
  providerBindings           ProjectProviderBinding[]
  leposhipBuilds             LepoShipBuild[]
  canonicalBuildJobs         BundleBuildJobs[]

  @@map("projects")
}

model BundlePayouts {
  id              String   @id @db.Uuid
  developerId     String   @map("developer_id") @db.Uuid
  amount          Float
  currency        String   @default("VND") @db.VarChar(10)
  periodStart     BigInt   @map("period_start")
  periodEnd       BigInt   @map("period_end")
  status          String   @default("pending") @db.VarChar(30)
  bankAccount     String?  @map("bank_account") @db.VarChar(255)
  transactionRef  String?  @map("transaction_ref") @db.VarChar(255)
  workspaceId     String?  @map("workspace_id") @db.Uuid
  stripePayoutId  String?  @unique @map("stripe_payout_id") @db.VarChar(255)
  stripeAccountId String?  @map("stripe_account_id") @db.VarChar(255)
  createdAt       DateTime @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @map("updated_at") @db.Timestamp(6)

  developer User @relation(fields: [developerId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([developerId], map: "bundle_payouts_developer_id")
  @@index([status], map: "bundle_payouts_status")
  @@map("bundle_payouts")
}

model Bundles {
  id                String              @id @db.Uuid
  bundleKey         String?             @unique @map("bundle_key") @db.VarChar(255)
  name              String              @db.VarChar(255)
  slug              String?             @unique @db.VarChar(255)
  version           String              @default("1.0.0") @db.VarChar(50)
  buildNumber       Int                 @default(1) @map("build_number")
  iconUrl           String?             @map("icon_url") @db.VarChar(500)
  bannerUrl         String?             @map("banner_url") @db.VarChar(500)
  shortDescription  String?             @map("short_description") @db.VarChar(255)
  description       String?
  privacyPolicyUrl  String?             @map("privacy_policy_url") @db.VarChar(500)
  supportUrl        String?             @map("support_url") @db.VarChar(500)
  websiteUrl        String?             @map("website_url") @db.VarChar(500)
  developerName     String?             @map("developer_name") @db.VarChar(255)
  developerId       String?             @map("developer_id") @db.Uuid
  developerEmail    String?             @map("developer_email") @db.VarChar(255)
  category          String?             @db.VarChar(100)
  subCategory       String?             @map("sub_category") @db.VarChar(100)
  storagePath       String              @map("storage_path") @db.VarChar(500)
  bucket            String              @db.VarChar(100)
  fileSize          BigInt?             @map("file_size")
  checksum          String?             @db.VarChar(128)
  price             Float?
  currency          String?             @db.VarChar(10)
  isFree            Boolean             @default(true) @map("is_free")
  isOneTimePayment  Boolean             @default(false) @map("is_one_time_payment")
  hasInAppPurchases Boolean             @default(false) @map("has_in_app_purchases")
  hasSubscription   Boolean             @default(false) @map("has_subscription")
  status            BundleCatalogStatus @default(draft)
  rejectionReason   String?             @map("rejection_reason")
  publishedAt       DateTime?           @map("published_at") @db.Timestamp(6)
  expiresAt         DateTime?           @map("expires_at") @db.Timestamp(6)
  changelog         String?
  releaseNotes      String?             @map("release_notes")
  ageRating         String?             @map("age_rating") @db.VarChar(10)
  contentAdvisory   String?             @map("content_advisory")
  createdAt         DateTime            @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime            @map("updated_at") @db.Timestamp(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamp(6)

  projectId             String?            @unique @map("project_id") @db.Uuid
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vercelDeploymentId    String?            @map("vercel_deployment_id") @db.VarChar(255)
  vercelDeploymentUrl   String?            @map("vercel_deployment_url") @db.VarChar(255)
  primaryReleaseTrackId String?            @unique @map("primary_release_track_id") @db.Uuid
  activeAbTestId        String?            @unique @map("active_ab_test_id") @db.Uuid
  activeRolloutId       String?            @unique @map("active_rollout_id") @db.Uuid
  activeDeliveryMode    BundleDeliveryMode @default(none) @map("active_delivery_mode")

  abTests              BundleAbTests[]                @relation("BundleAbTests")
  activeAbTest         BundleAbTests?                 @relation("BundleActiveAbTest", fields: [activeAbTestId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  activeRollout        BundleDeliveryRollouts?        @relation("BundleActiveDeliveryRollout", fields: [activeRolloutId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  abuseSignals         BundleAbuseSignals?
  adConfigurations     BundleAdConfigurations?
  analyticsEvents      BundleAnalyticsEvents[]
  apiUsageStats        BundleApiUsageStats[]
  auditLogs            BundleAuditLog[]
  betaTesters          BundleBetaTesters[]
  changeLogs           BundleChangeLogs[]
  collaborators        BundleCollaborators[]
  contentRatings       BundleContentRatings[]
  countries            BundleCountries[]
  dependencies         BundleDependencies[]           @relation("BundleSource")
  dependentBundles     BundleDependencies[]           @relation("BundleDependency")
  developerStrikes     BundleDeveloperStrikes[]
  deviceSupports       BundleDeviceSupport[]
  externalIntegrations BundleExternalIntegrations[]
  featuredSlots        BundleFeaturedSlots[]
  inAppPurchases       BundleInAppPurchases[]
  installEvents        BundleInstallEvents[]
  languages            BundleLanguages[]
  localizations        BundleLocalizations[]
  monetizationConfigs  BundleMonetizationConfigs?
  orders               BundleOrders[]
  permissions          BundlePermissions[]
  privacyDeclarations  BundlePrivacyDeclarations?
  promotions           BundlePromotions[]
  rankingScores        BundleRankingScores?
  releaseTracks        BundleReleaseTracks[]          @relation("BundleReleaseTracks")
  primaryReleaseTrack  BundleReleaseTracks?           @relation("BundlePrimaryReleaseTrack", fields: [primaryReleaseTrackId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  retentionStats       BundleRetentionStats[]
  reviews              BundleReviews[]
  runtimeConfig        BundleRuntimeConfig?
  screenshots          BundleScreenshots[]
  searchKeywords       BundleSearchKeywords[]
  stateTransitions     BundleStateTransitions[]
  stats                BundleStats?
  storeFlags           BundleStoreFlags?
  storeListings        BundleStoreListings[]
  subscriptionPlans    BundleSubscriptionPlans[]
  tags                 BundleTags[]
  trendingSnapshots    BundleTrendingSnapshots[]
  userReports          BundleUserReports[]
  versionHistories     BundleVersionHistory[]
  webhooks             BundleWebhooks[]
  userEntitlements     BundleUserEntitlements[]
  rollouts             BundleRollouts[]
  subscriptionHistory  BundleSubscriptionHistory[]
  crashReports         BundleCrashReports[]
  crashEvents          BundleCrashEvents[]
  reviewHistory        BundleReviewHistory[]
  reviewQueue          BundleReviewQueue[]
  securityScanResults  BundleSecurityScanResults[]
  updatePhases         BundleUpdatePhases[]
  artifactManifests    BundleArtifactManifests[]
  rolloutExposures     BundleRolloutExposures[]
  runtimeConfigEntries BundleRuntimeConfigEntries[]
  financialLedger      BundleFinancialLedgerEntries[]
  channels             BundleChannels[]
  releases             BundleReleases[]
  canonicalBuildJobs   BundleBuildJobs[]
  canonicalRollouts    BundleDeliveryRollouts[]       @relation("BundleDeliveryRollouts")
  releaseOverridesV2   BundleReleaseOverridesV2[]
  ledgerAccounts       BundleLedgerAccounts[]
  ledgerTransactions   BundleLedgerTransactions[]
  stripeWebhookEvents  BundleStripeWebhookEvents[]
  sdkTokens            BundleSdkTokens[]

  @@index([category, status], map: "bundles_category_status")
  @@index([createdAt], map: "bundles_created_at")
  @@index([status], map: "bundles_status")
  @@map("bundles")
}

model BundleChannels {
  id               String   @id @db.Uuid
  bundleId         String   @map("bundle_id") @db.Uuid
  name             String   @db.VarChar(40)
  currentReleaseId String?  @map("current_release_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamp(6)

  bundle         Bundles                  @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  currentRelease BundleReleases?          @relation("ChannelCurrentRelease", fields: [currentReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  releases       BundleReleases[]         @relation("ReleaseChannel")
  rollouts       BundleDeliveryRollouts[]

  @@unique([bundleId, name])
  @@index([currentReleaseId], map: "bundle_channels_current_release")
  @@map("bundle_channels")
}

model BundleReleases {
  id           String              @id @db.Uuid
  bundleId     String              @map("bundle_id") @db.Uuid
  channelId    String              @map("channel_id") @db.Uuid
  version      String              @db.VarChar(50)
  buildNumber  Int                 @map("build_number")
  status       BundleReleaseStatus @default(queued)
  source       String              @default("manual") @db.VarChar(30)
  sourceCommit String?             @map("source_commit") @db.VarChar(64)
  releaseNotes String?             @map("release_notes")
  createdById  String?             @map("created_by_id") @db.Uuid
  submittedAt  DateTime?           @map("submitted_at") @db.Timestamp(6)
  approvedAt   DateTime?           @map("approved_at") @db.Timestamp(6)
  activatedAt  DateTime?           @map("activated_at") @db.Timestamp(6)
  createdAt    DateTime            @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime            @map("updated_at") @db.Timestamp(6)

  bundle                Bundles                          @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  channel               BundleChannels                   @relation("ReleaseChannel", fields: [channelId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  currentForChannels    BundleChannels[]                 @relation("ChannelCurrentRelease")
  artifacts             BundleArtifacts[]
  buildJobs             BundleBuildJobs[]
  approvals             BundleReleaseApprovals[]
  overrides             BundleReleaseOverridesV2[]
  baselineRollouts      BundleDeliveryRollouts[]         @relation("RolloutBaselineRelease")
  candidateRollouts     BundleDeliveryRollouts[]         @relation("RolloutCandidateRelease")
  rolloutExposures      BundleDeliveryRolloutExposures[]
  controlExperiments    BundleAbTests[]                  @relation("BundleAbControlRelease")
  treatmentExperiments  BundleAbTests[]                  @relation("BundleAbTreatmentRelease")
  reviewQueue           BundleReviewQueue[]
  crashEvents           BundleCrashEvents[]
  bundleAbTestExposures BundleAbTestExposures[]

  @@unique([bundleId, buildNumber])
  @@unique([bundleId, version, buildNumber])
  @@index([bundleId, status, createdAt], map: "bundle_releases_status_time")
  @@map("bundle_releases")
}

model BundleArtifacts {
  id                String             @id @db.Uuid
  releaseId         String             @map("release_id") @db.Uuid
  kind              BundleArtifactKind
  storageProvider   String             @map("storage_provider") @db.VarChar(30)
  storageBucket     String             @map("storage_bucket") @db.VarChar(100)
  storageKey        String             @map("storage_key") @db.VarChar(500)
  checksumSha256    String             @map("checksum_sha256") @db.VarChar(64)
  fileSize          BigInt             @map("file_size")
  contentType       String             @map("content_type") @db.VarChar(100)
  baseBuildNumber   Int?               @map("base_build_number")
  targetBuildNumber Int?               @map("target_build_number")
  metadata          Json?
  createdAt         DateTime           @map("created_at") @db.Timestamp(6)

  release BundleReleases @relation(fields: [releaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([storageProvider, storageBucket, storageKey])
  @@unique([releaseId, kind, baseBuildNumber, targetBuildNumber])
  @@index([releaseId, kind], map: "bundle_artifacts_release_kind")
  @@map("bundle_artifacts")
}

model BundleBuildJobs {
  id            String            @id @db.Uuid
  bundleId      String            @map("bundle_id") @db.Uuid
  releaseId     String            @map("release_id") @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  triggeredById String?           @map("triggered_by_id") @db.Uuid
  queueJobId    String?           @unique @map("queue_job_id") @db.VarChar(255)
  status        BundleBuildStatus @default(queued)
  attempt       Int               @default(0)
  maxAttempts   Int               @default(3) @map("max_attempts")
  workerId      String?           @map("worker_id") @db.VarChar(128)
  heartbeatAt   DateTime?         @map("heartbeat_at") @db.Timestamp(6)
  startedAt     DateTime?         @map("started_at") @db.Timestamp(6)
  completedAt   DateTime?         @map("completed_at") @db.Timestamp(6)
  errorCode     String?           @map("error_code") @db.VarChar(100)
  errorMessage  String?           @map("error_message")
  createdAt     DateTime          @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime          @map("updated_at") @db.Timestamp(6)

  bundle      Bundles                @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  release     BundleReleases         @relation(fields: [releaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  triggeredBy User?                  @relation("BundleBuildTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  logs        BundleBuildLogChunks[]

  @@index([status, heartbeatAt], map: "bundle_build_jobs_recovery")
  @@index([bundleId, createdAt], map: "bundle_build_jobs_bundle_time")
  @@map("bundle_build_jobs")
}

model BundleBuildLogChunks {
  id        String   @id @db.Uuid
  buildId   String   @map("build_id") @db.Uuid
  sequence  Int
  level     String   @default("info") @db.VarChar(20)
  message   String
  createdAt DateTime @map("created_at") @db.Timestamp(6)

  build BundleBuildJobs @relation(fields: [buildId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([buildId, sequence])
  @@index([buildId, createdAt], map: "bundle_build_log_chunks_time")
  @@map("bundle_build_log_chunks")
}

model BundleReleaseApprovals {
  id            String             @id @db.Uuid
  releaseId     String             @map("release_id") @db.Uuid
  kind          BundleApprovalKind
  status        String             @db.VarChar(20)
  actorId       String?            @map("actor_id") @db.Uuid
  evidence      Json?
  policyVersion String?            @map("policy_version") @db.VarChar(30)
  createdAt     DateTime           @map("created_at") @db.Timestamp(6)

  release BundleReleases @relation(fields: [releaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  actor   User?          @relation("ReleaseApprovalActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([releaseId, kind])
  @@index([status], map: "bundle_release_approvals_status")
  @@map("bundle_release_approvals")
}

model BundleReleaseOverridesV2 {
  id          String    @id @db.Uuid
  bundleId    String    @map("bundle_id") @db.Uuid
  releaseId   String    @map("release_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  reason      String
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt   DateTime  @map("created_at") @db.Timestamp(6)

  bundle    Bundles                          @relation(fields: [bundleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  release   BundleReleases                   @relation(fields: [releaseId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  createdBy User                             @relation("ReleaseOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvals BundleReleaseOverrideApprovals[]

  @@index([releaseId, expiresAt], map: "bundle_release_overrides_v2_active")
  @@map("bundle_release_overrides_v2")
}

model BundleReleaseOverrideApprovals {
  id         String   @id @db.Uuid
  overrideId String   @map("override_id") @db.Uuid
  approverId String   @map("approver_id") @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamp(6)

  override BundleReleaseOverridesV2 @relation(fields: [overrideId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  approver User                     @relation("ReleaseOverrideApprover", fields: [approverId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([overrideId, approverId])
  @@map("bundle_release_override_approvals")
}

model BundleDeliveryRollouts {
  id                 String    @id @db.Uuid
  bundleId           String    @map("bundle_id") @db.Uuid
